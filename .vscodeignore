# Editor & CI config
.vscode/**
.vscode-test/**
.github/**

# Dependencies & build output — this extension has no runtime bundle;
# the .vsix ships package.json + snippets/ + README/CHANGELOG/LICENSE + images/icon.png
node_modules/**

# Source & build tooling — snippets/ are generated artifacts, tools/ is the generator
tools/**

# Test & QA harness
qa/**

# Repo config with no runtime role
.gitignore
.gitattributes
package-lock.json

# Maintainer docs — written for contributors, never shipped to users.
# The bare CLAUDE.md above matches root only, hence the explicit nested patterns.
CLAUDE.md
SPEC.md
SUPPORT.md
reference.md
snippets/**/CLAUDE.md
snippets/**/README.md

# Local-only working trees — agent state, private notes, design libraries.
# Self-ignored from git, so they never appear in `git status` — but vsce packages
# from disk, not from git, and would otherwise ship them. Must stay named here.
.claude/**

# Demo media — the README loads these from GitHub, so the package stays lean.
# .mov are the convert-to-gif masters. images/icon.png is the Marketplace icon
# and must NOT be excluded.
images/*.gif
images/*.mov
images/social-preview.png

# OS cruft
**/.DS_Store
